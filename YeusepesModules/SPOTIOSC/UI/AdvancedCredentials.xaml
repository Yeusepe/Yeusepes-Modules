<UserControl x:Class="YeusepesModules.SPOTIOSC.UI.AdvancedCredentials"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Surface" Color="#181818"/>
        <SolidColorBrush x:Key="Field" Color="#121212"/>
        <SolidColorBrush x:Key="Hairline" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Subdued" Color="#B3B3B3"/>
        <SolidColorBrush x:Key="Accent" Color="#1ED760"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Foreground" Value="{StaticResource Subdued}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Subdued}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource Hairline}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill"
                                CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Pill" Property="Background" Value="#3BE477"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#3BE477"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame"
                                Height="40"
                                Padding="12,0"
                                CornerRadius="4"
                                Background="{StaticResource Field}"
                                BorderBrush="#727272"
                                BorderThickness="1">
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="Hint"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#727272"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Button x:Name="ToggleButton"
                Click="ToggleButton_Click"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                Margin="0,0,0,12">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,8">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Advanced" Style="{StaticResource Title}"/>
                <TextBlock x:Name="ArrowIcon"
                           Grid.Column="1"
                           Text="&#xE70D;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </Grid>
        </Button>

        <StackPanel x:Name="Panel" Visibility="Collapsed">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Your own Spotify app" Style="{StaticResource Title}"/>
                        <Border Grid.Column="1" CornerRadius="12" Background="{StaticResource Hairline}" Padding="10,4">
                            <TextBlock x:Name="AppModeText" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Gives SpotiOSC its own Spotify API limits instead of sharing the default ones."/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepNumber}"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Body}">Create an app in the <Hyperlink NavigateUri="https://developer.spotify.com/dashboard" RequestNavigate="Link_RequestNavigate">Spotify Developer Dashboard</Hyperlink>.</TextBlock>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="Name and description can be anything. Website is optional."/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Step}"><TextBlock Text="2" Style="{StaticResource StepNumber}"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Body}" Text="Add this Redirect URI to the app."/>
                            <Border Margin="0,8,0,0" Height="40" CornerRadius="4" Background="{StaticResource Field}" Padding="12,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RedirectUriText" Style="{StaticResource Mono}" Foreground="White"/>
                                    <Button Grid.Column="1" Content="Copy" Style="{StaticResource TextButton}" Click="CopyRedirectUri_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Step}"><TextBlock Text="3" Style="{StaticResource StepNumber}"/></Border>
                        <TextBlock Grid.Column="1" Style="{StaticResource Body}" VerticalAlignment="Top"
                                   Text="Select Web API, accept the terms and save."/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Step}"><TextBlock Text="4" Style="{StaticResource StepNumber}"/></Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Body}" Text="Paste the app's Client ID and connect."/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClientIdBox" Style="{StaticResource FieldBox}" Tag="Client ID"/>
                                <Button Grid.Column="1" Content="Connect" Style="{StaticResource PillButton}"
                                        Click="UseCustomApp_Click" Margin="12,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="ApiClientStatus" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,20,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Caption}">No Client Secret needed. Other accounts must be added under User Management. <Hyperlink NavigateUri="https://developer.spotify.com/documentation/web-api/concepts/apps" RequestNavigate="Link_RequestNavigate">Learn more</Hyperlink></TextBlock>
                        <Button x:Name="UseDefaultButton" Grid.Column="1" Content="Use default app"
                                Style="{StaticResource TextButton}" Click="UseDefaultApp_Click" Margin="12,0,-12,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,20,8,8">
                <StackPanel>
                    <TextBlock Text="Session tokens" Style="{StaticResource Title}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,12,8"
                               Text="Hover a row to reveal its value. Never share these."/>

                    <Border x:Name="AccessTokenBorder" Height="44" Background="Transparent"
                            MouseEnter="AccessTokenBorder_MouseEnter" MouseLeave="TokenBorder_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Access token" Style="{StaticResource Body}"/>
                            <TextBlock x:Name="AccessTokenText" Grid.Column="1" Style="{StaticResource Mono}"/>
                            <Button Grid.Column="2" Content="Copy" Style="{StaticResource TextButton}" Click="CopyAccessToken_Click"/>
                        </Grid>
                    </Border>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,0,12,0"/>
                    <Border x:Name="ClientTokenBorder" Height="44" Background="Transparent"
                            MouseEnter="ClientTokenBorder_MouseEnter" MouseLeave="TokenBorder_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Client token" Style="{StaticResource Body}"/>
                            <TextBlock x:Name="ClientTokenText" Grid.Column="1" Style="{StaticResource Mono}"/>
                            <Button Grid.Column="2" Content="Copy" Style="{StaticResource TextButton}" Click="CopyClientToken_Click"/>
                        </Grid>
                    </Border>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,0,12,0"/>
                    <Border x:Name="SpTTokenBorder" Height="44" Background="Transparent"
                            MouseEnter="SpTTokenBorder_MouseEnter" MouseLeave="TokenBorder_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Session (sp_t)" Style="{StaticResource Body}"/>
                            <TextBlock x:Name="SpTTokenText" Grid.Column="1" Style="{StaticResource Mono}"/>
                            <Button Grid.Column="2" Content="Copy" Style="{StaticResource TextButton}" Click="CopySpTToken_Click"/>
                        </Grid>
                    </Border>
                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,0,12,0"/>
                    <Border x:Name="ApiAccessTokenBorder" Height="44" Background="Transparent"
                            MouseEnter="ApiAccessTokenBorder_MouseEnter" MouseLeave="TokenBorder_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API token" Style="{StaticResource Body}"/>
                            <TextBlock x:Name="ApiAccessTokenText" Grid.Column="1" Style="{StaticResource Mono}"/>
                            <Button Grid.Column="2" Content="Copy" Style="{StaticResource TextButton}" Click="CopyApiAccessToken_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
